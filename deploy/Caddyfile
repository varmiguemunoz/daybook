# Edge proxy for a VPS: TLS certificates from Let's Encrypt, one site per domain.
# Point the DNS A records of both domains at the server before the first start.
{$APP_DOMAIN:app.sprintos.run} {
	encode zstd gzip
	reverse_proxy web:8080
}

{$API_DOMAIN:api.sprintos.run} {
	encode zstd gzip
	# Spreads requests over every API replica Docker resolves for the name "api".
	reverse_proxy {
		dynamic a {
			name api
			port 3001
			refresh 5s
		}
		lb_policy round_robin
		# Active health checks do not run for dynamic upstreams: a replica that refuses connections
		# (restarting or shutting down) is skipped for 10s and the request goes to another one.
		fail_duration 10s
		lb_try_duration 5s
		# Server-Sent Events stream without buffering.
		flush_interval -1
	}
}
