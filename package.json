{
  "name": "daybook",
  "version": "2.0.0",
  "license": "MIT",
  "private": true,
  "description": "Daybook: personal tasks and notes by organisation. React + Vite client, Hono API, MongoDB.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @daybook/web",
    "dev:api": "npm run dev --workspace @daybook/api",
    "build": "npm run build --workspaces --if-present",
    "preview": "npm run preview --workspace @daybook/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f mongo"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.2"
  }
}
