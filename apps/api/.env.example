# Runtime: development (default) or production. Production refuses PERSISTENCE=memory.
NODE_ENV=development

# Port for the Hono API
PORT=3001

# Persistence adapter: memory (default, seeded) or mongo
PERSISTENCE=memory

# MongoDB connection string (only used when PERSISTENCE=mongo)
# Credentials match docker-compose.yml (MONGO_USER / MONGO_PASSWORD).
MONGODB_URI=mongodb://daybook:daybookpass@127.0.0.1:27017/daybook?authSource=admin

# Clerk (required). The API refuses to boot without them.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# Comma-separated origins allowed to call the API (web dev server and Tauri webviews)
ALLOWED_ORIGINS=http://localhost:5175,tauri://localhost,http://tauri.localhost
# Production example: https://app.sprintos.run,tauri://localhost,http://tauri.localhost

# Email notifications (optional). Set SMTP_HOST, SMTP_USER and SMTP_PASS together, or leave all empty to send in-app notifications only.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sender address; defaults to SMTP_USER
SMTP_FROM=

# Redis (optional). Needed to run more than one API instance: it shares realtime events and rate limits between them.
# Leave it commented out for a single instance. Docker Compose (docker-compose.prod.yml) sets it for you.
# REDIS_URL=redis://127.0.0.1:6379

# Per-workspace limits for a hosted instance (optional). 0 means no limit.
MAX_TASKS_PER_WORKSPACE=0
MAX_NOTES_PER_WORKSPACE=0

# Public URLs (optional in development). AI assistants connect to PUBLIC_API_URL/mcp, and Clerk must list
# that exact URL as an MCP server. Invitations sent by an assistant land on APP_URL.
# Production: PUBLIC_API_URL=https://api.sprintos.run and APP_URL=https://app.sprintos.run
# PUBLIC_API_URL=http://localhost:3001
# APP_URL=http://localhost:5175
