# Port for the Hono API
PORT=3001

# Persistence adapter: memory (default, seeded) or mongo
PERSISTENCE=memory

# MongoDB connection string (only used when PERSISTENCE=mongo)
# Credentials match docker-compose.yml (MONGO_USER / MONGO_PASSWORD).
MONGODB_URI=mongodb://gr8r:gr8rpass@127.0.0.1:27017/gr8r?authSource=admin

# Clerk (optional; when set, API verifies sessions via Clerk instead of x-member-id header)
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
